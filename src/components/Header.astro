---
// RF-01 · Cabecera fija con navegación y menú móvil.
const links = [
  { href: '#catalogo', label: 'Catálogo' },
  { href: '#origen', label: 'Origen' },
  { href: '#pedido', label: 'Pedido' },
];
---
<header class="fixed inset-x-0 top-0 z-40 border-b border-white/10 bg-tierra/95 text-crema backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="#inicio" class="flex items-center gap-2 font-display text-xl font-bold">
      <img src="/favicon.svg" alt="" width="28" height="28" />
      Tierra Alta
    </a>
    <nav aria-label="Principal" class="hidden gap-8 text-sm font-medium md:flex">
      {links.map((l) => <a href={l.href} class="transition hover:text-miel">{l.label}</a>)}
    </nav>
    <button id="menu-btn" type="button" class="rounded p-2 md:hidden" aria-expanded="false" aria-controls="menu-movil" aria-label="Abrir menú">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
  </div>
  <nav id="menu-movil" aria-label="Principal móvil" class="hidden border-t border-white/10 bg-tierra px-4 pb-4 md:hidden">
    {links.map((l) => <a href={l.href} class="block py-3 text-base font-medium">{l.label}</a>)}
  </nav>
</header>
